# Identity used only in optional model prompts and notifications.
AGENT_NAME=心潮
NOTIFICATION_RECIPIENT=用户

# Safe startup defaults.
SHADOW_MODE=true
PORT=18110
SERVICE_TOKEN=replace-with-a-random-secret
STATE_PATH=/app/state/state.json
SETTLE_INTERVAL_MINUTES=15
SLEEP_AFTER_MINUTES=90

# Optional OpenAI-compatible model. Disabled by default.
MODEL_ENABLED=false
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_API_KEY=
MODEL_NAME=local-model
MODEL_TIMEOUT_MS=30000
MODEL_MAX_INPUT_CHARS=10000
MODEL_MAX_OUTPUT_TOKENS=650
DREAM_PUSH_PROMPT_PATH=/app/configs/dream_push_prompt.md
DREAM_MIN_INTERVAL_HOURS=6
DREAM_MAX_PER_DAY=4

# Optional Streamable HTTP Memory MCP. Disabled by default.
MEMORY_MCP_URL=
MEMORY_MCP_TOKEN=
MEMORY_READ_ENABLED=false
MEMORY_WRITE_ENABLED=false
MEMORY_READ_TOOL=breath
MEMORY_WRITE_TOOL=hold
MEMORY_BREATH_MAX_RESULTS=3
MEMORY_BREATH_MAX_TOKENS=800

# Optional heartbeat file supplied by an external memory/agent service.
MEMORY_DATA_HOST_PATH=./memory-data
MEMORY_HEARTBEAT_FILE=/memory-data/heartbeat.json
BARK_DREAM_MIN_CONTACT_IDLE_HOURS=3
BARK_MIN_CONTACT_IDLE_HOURS=12

# Optional Bark notifications. Disabled by default.
BARK_ENABLED=false
BARK_KEY=
BARK_SERVER=https://api.day.app
BARK_TITLE=心潮
BARK_GROUP=xinchao
BARK_ICON=
BARK_SOUND=silence
BARK_LEVEL=timeSensitive
BARK_MIN_INTERVAL_HOURS=3
BARK_AUTONOMOUS_MIN_INTERVAL_HOURS=12
BARK_MAX_PER_DAY=6
BARK_MIN_DRIVE=0.42

# Settle options.
SETTLE_TIME_ZONE=Asia/Shanghai
DAWN_FREEZE_START=1
DAWN_FREEZE_END=8

# Optional daytime emergence. Disabled by default.
DAYTIME_EMERGENCE_ENABLED=false
DAYTIME_TIME_ZONE=Asia/Shanghai
DAYTIME_START_HOUR=8
DAYTIME_END_HOUR=23
DAYTIME_MIN_INTERVAL_HOURS=2
DAYTIME_MAX_INTERVAL_HOURS=3
DAYTIME_MAX_PER_DAY=7
